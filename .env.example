# ==============================================================================
# NanoStack 3D Configuration Template
# Copy this file to '.env' and customize it with your private details.
# DO NOT commit '.env' to version control!
# ==============================================================================

# User & HPC Notifications
SLURM_NOTIFICATION_EMAIL=user@institution.edu
AMAREL_PROJECT_DIR=/projects/[PROJECT_ALLOCATION]   # e.g. /projects/xx_yy_zzz

# Security & Application Settings
NANOSTACK_READ_ONLY=true
NANOSTACK_LOG_LEVEL=INFO
